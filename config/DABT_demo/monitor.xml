<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="tui.xsd" on_visit="on_monitor_visit">
  <script src="monitor_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="h">
    <pane id="nav" weight="20" title="Menu" border="single" class="sidebar"/>
    <pane id="main" split="v" weight="80">
      <pane id="header" weight="6" title="System Monitor" border="single" class="panel"/>

      <pane id="controls" split="grid" weight="8" rows="1" cols="6" fit="stretch" border="single" class="panel">
        <pane id="ctl_cpu"      border="none"/>
        <pane id="ctl_mem"      border="none"/>
        <pane id="ctl_load"     border="none"/>
        <pane id="ctl_disk"     border="none"/>
        <pane id="ctl_interval" border="none"/>
        <pane id="ctl_refresh"  border="none"/>
      </pane>

      <pane id="grid" split="grid" weight="86" rows="2" cols="2">
        <pane id="cpu_pane"  title="CPU Cores — vbar"          border="heavy" class="panel"/>
        <pane id="mem_pane"  title="Memory — gauge"            border="heavy" class="panel"/>
        <pane id="load_pane" title="Load Average — linechart"  border="heavy" class="panel"/>
        <pane id="disk_pane" title="Disk Usage &amp; I/O — hbar" border="heavy" class="panel"/>
      </pane>
    </pane>
  </pane>

  <label id="lbl_mon_inst"  pane="header" row="0" text="Live system stats sampled straight from /proc and df." align="center"/>
  <label id="lbl_mon_stamp" pane="header" row="1" text="—" align="center" class="muted_label"/>

  <checkbox id="chk_mon_cpu"  pane="ctl_cpu"  row="0" label="CPU"    checked="true" action="on_monitor_toggle_cpu"/>
  <checkbox id="chk_mon_mem"  pane="ctl_mem"  row="0" label="Memory" checked="true" action="on_monitor_toggle_mem"/>
  <checkbox id="chk_mon_load" pane="ctl_load" row="0" label="Load"   checked="true" action="on_monitor_toggle_load"/>
  <checkbox id="chk_mon_disk" pane="ctl_disk" row="0" label="Disk"   checked="true" action="on_monitor_toggle_disk"/>
  <input  id="inp_mon_interval" pane="ctl_interval" row="0" label="Sec:" label_width="5" placeholder="1" submit="on_monitor_set_interval"/>
  <button id="btn_mon_refresh"  pane="ctl_refresh"  row="0" text="[ Refresh ]" action="on_monitor_refresh" class="success_button" align="fill"/>

  <include src="_nav.xml"/>
</tui>
