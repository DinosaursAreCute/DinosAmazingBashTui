<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="on_home_visit">
  <include src="_keys.xml"/>
  <script src="home_callbacks.sh"/>
  <theme src="theme.css"/>
  <footer/>

  <!-- Home has no menu and no title bar of its own: the hero is the title and the list is the menu, all in one fused grid -->
  <pane id="root" split="v" border="none">
    <pane id="home_hero" fuse="true" divider="single" height="clamp(15,15,15)" border="single" class="panel" scroll="none"/>
    <pane id="home_tour" fuse="true" divider="single" weight="1" title="Where to go" border="single" class="panel" hpad="2" scroll="v">
      <button id="btn_t_components" text="Components  every renderer, theme colors, fit-to-size, live tab" page="components.xml" class="nav_link" align="left"/>
      <button id="btn_t_settings" text="Settings    switch themes app-wide, borders, padding, fonts" page="settings.xml" class="nav_link" align="left"/>
      <button id="btn_t_monitor" text="Monitor     CPU, memory, load and disk straight from /proc" page="monitor.xml" class="nav_link" align="left"/>
      <button id="btn_t_terminal" text="Terminal    a real bash session running inside a pane" page="terminal.xml" class="nav_link" align="left"/>
      <button id="btn_t_scrolling" text="Scrolling   wheel, drag and vim keys; scrolling widget forms" page="scrolling.xml" class="nav_link" align="left"/>
      <button id="btn_t_case" text="Case Study  a benchmark page built from the same parts" page="case_study.xml" class="nav_link" align="left"/>
      <button id="btn_t_docs" text="Docs        the design write-ups, one tab per file" page="docu.xml" class="nav_link" align="left"/>
      <button id="btn_t_layout" text="Layout      alignment, min/max sizing, padding, borders" page="features.xml" class="nav_link" align="left"/>
      <button id="btn_t_workspace" text="Workspace   an on-call console: fused logs, draggable dividers, a rail" page="workspace.xml" class="nav_link" align="left"/>
      <button id="btn_t_widgets" text="Widgets     every widget, nested in its pane" page="widgets.xml" class="nav_link" align="left"/>
      <button id="btn_t_layers" text="Layers      windows, a modal, a popup, a toast, detachable logs" page="layers.xml" class="nav_link" align="left"/>
      <button id="btn_t_compose" text="Compose     templates, conditionals, addons, the page changing live" page="compose.xml" class="nav_link" align="left"/>
      <button id="btn_t_keys" text="Keys        every key binding, live" page="keys.xml" class="nav_link" align="left"/>
      <button id="btn_t_debug" text="Debug       input tape, hover and focus readout, dynamic grid" page="debug.xml" class="nav_link" align="left"/>
    </pane>
    <pane id="footer" fuse="true" divider="single" height="clamp(3,3,3)" border="single" class="panel">
      <label id="lbl_footer" text="DinosAmazingBashTui" align="center" class="muted_label"/>
    </pane>
  </pane>

  <use template="dabt_keys"/>
</tui>
