<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="tui.xsd">
  <include src="_templates.xml"/>
  <script src="case_study_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <use template="dabt_header"/>
  <pane id="root1" weight="90" split="h">
    <pane id="nav" weight="18" title="Menu" border="single" class="sidebar"/>
    <pane id="main" split="v" weight="82">
        <pane id="header" weight="12" title="Real World: High-Performance Viewports" border="single" class="panel">
          <label id="lbl_inst" text="Stress test the new AWK shader architecture." align="center"/>
          <label id="lbl_inst2" text="Click a tab below to generate and render the layouts." align="center" class="muted_label"/>
        </pane>
        <pane id="tabs_header" weight="4" border="none"/>
        <pane id="content" weight="84" border="heavy" class="panel" scroll="both"/>
    </pane>
  </pane>
  </pane>


  <!-- compact: tabs_header is only weight="4" (~1 row), nowhere near the
       3 rows a framed (bordered) header cell would need. -->
  <tabs id="case_tabs" header_pane="tabs_header" content_pane="content" style="compact">
    <tab id="tab_doc" text="Technical Document" action="on_tab_doc" default="true"/>
    <tab id="tab_tbl" text="Live Metrics Table" action="on_tab_tbl"/>
  </tabs>

  <use template="dabt_nav"/>
</tui>
