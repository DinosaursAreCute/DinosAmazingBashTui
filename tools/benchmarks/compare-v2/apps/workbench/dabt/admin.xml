<tui shell="_shell.xml" on_visit="wb_admin_visit">
  <pane id="main" width="fill" split="v" border="none">
    <pane id="adm_head" weight="3" border="none" class="panel"/>
    <pane id="adm_body" weight="17" title="Admin" border="single" class="panel" hpad="1">
      <label row="0" id="lbl_page"  text="Page 6: Admin"/>
      <label row="1" id="lbl_tab"   text="Tab: General"/>
      <label row="2" id="lbl_theme" text="Theme: dark"/>
    </pane>
    <pane id="acc" weight="80" split="v" border="none">
      <pane id="d_net"  weight="1" title="Network"  border="single" class="panel" hpad="1" collapsible="true" collapse_to="title">
        <label row="0" id="lbl_net" text="Network: 3 interfaces up"/>
      </pane>
      <pane id="d_disk" weight="1" title="Storage"  border="single" class="panel" hpad="1" collapsible="true" collapse_to="title">
        <label row="0" id="lbl_disk" text="Storage: 62% used"/>
      </pane>
      <pane id="d_sec"  weight="1" title="Security" border="single" class="panel" hpad="1" collapsible="true" collapse_to="title">
        <label row="0" id="lbl_sec" text="Security: no findings"/>
      </pane>
    </pane>
  </pane>

  <tabs id="admin_tabs" header_pane="adm_head" content_pane="adm_body" style="compact">
    <tab id="tab_gen" text="General"    action="wb_tab_general" default="true"/>
    <tab id="tab_app" text="Appearance" action="wb_tab_appearance"/>
  </tabs>

  <bind key="alt+g" action="wb_goto_tab_general"    desc="General"/>
  <bind key="alt+v" action="wb_goto_tab_appearance" desc="Appearance"/>
  <bind key="alt+z" action="wb_toggle_network"      desc="Network"/>
  <bind key="alt+m" action="wb_theme_toggle"        desc="Theme"/>
</tui>
