<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="tui.xsd">
  <include src="_templates.xml"/>
  <script src="demo_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <use template="dabt_header"/>
  <pane id="root1" weight="90" split="h">
    <pane id="nav" weight="18" title="Menu" border="single" class="sidebar"/>
    <pane id="main" split="v" weight="82">
      <pane id="term_output"  weight="75" title="Live Terminal (bash)" border="heavy" class="panel" scroll="both"/>
      <pane id="term_actions" weight="25" title="Terminal Controls"/>
    </pane>
  </pane>
  </pane>

  <!-- input at the bottom (term_actions), output on top (term_output) - a real bash session -->
  <script src="terminal_init.sh"/>

  <use template="dabt_nav"/>
</tui>
 
