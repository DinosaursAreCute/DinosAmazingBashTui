<!-- DABT default keybinds. Loaded once by lib/tui_input.sh (tui.bind.defaults).
     One <bind> per line:  key  action  group  [always="true"]  [desc]
     - key:    see docs/guide/input-bindings.md (ctrl+alt+x, shift+up, wheel:down, mouse:left, paste, ...)
     - action: a function + optional args; several may be chained with ';'
     - group:  the opt-out unit. Turn a whole group off with  tui.defaults.off GROUP  or
               <tui defaults="-GROUP">  (per page).  tui.defaults.list shows them.
     Your own tui.bind / <bind> always wins over a default. Override TUI_DEFAULTS_DIR to load another set. -->
<binds>
  <!-- focus: move between widgets -->
  <bind key="tab"       action="tui.action.focus_next"      group="focus" desc="Next widget"/>
  <bind key="shift+tab" action="tui.action.focus_prev"      group="focus" desc="Previous widget"/>
  <bind key="up"        action="tui.action.focus_dir up"    group="focus" desc="Widget above (same column)"/>
  <bind key="down"      action="tui.action.focus_dir down"  group="focus" desc="Widget below (same column)"/>
  <bind key="left"      action="tui.action.focus_dir left"  group="focus" desc="Widget to the left (same row)"/>
  <bind key="right"     action="tui.action.focus_dir right" group="focus" desc="Widget to the right"/>
  <bind key="enter"     action="tui.action.activate"        group="focus" desc="Activate focused widget"/>
  <bind key="alt+enter"  action="tui.action.activate"       group="focus" desc="Submit a multi-line text box"/>
  <bind key="ctrl+enter" action="tui.action.activate"       group="focus" desc="Submit a multi-line text box"/>
  <bind key="esc"       action="tui.action.unfocus"         group="focus" desc="Leave focused widget"/>

  <!-- pane: keyboard focus for whole panes (scroll target + highlighted border) -->
  <bind key="f6"        action="tui.action.pane_next"       group="pane" desc="Next pane"/>
  <bind key="shift+f6"  action="tui.action.pane_prev"       group="pane" desc="Previous pane"/>
  <bind key="alt+left"  action="tui.action.scroll_or_pane left"   group="pane" desc="Scroll left (else pane to the left)"/>
  <bind key="alt+right" action="tui.action.scroll_or_pane right"  group="pane" desc="Scroll right (else pane to the right)"/>
  <bind key="alt+up"    action="tui.action.scroll_or_pane up"     group="pane" desc="Scroll up (else pane above)"/>
  <bind key="alt+down"  action="tui.action.scroll_or_pane down"   group="pane" desc="Scroll down (else pane below)"/>

  <!-- scroll: keyboard scrolling of the target pane -->
  <bind key="shift+up"    action="tui.action.scroll up"     group="scroll" desc="Scroll up"/>
  <bind key="shift+down"  action="tui.action.scroll down"   group="scroll" desc="Scroll down"/>
  <bind key="shift+left"  action="tui.action.scroll left"   group="scroll" desc="Scroll left"/>
  <bind key="shift+right" action="tui.action.scroll right"  group="scroll" desc="Scroll right"/>
  <bind key="k"    action="tui.action.scroll up"            group="scroll" desc="Scroll up (vim)"/>
  <bind key="j"    action="tui.action.scroll down"          group="scroll" desc="Scroll down (vim)"/>
  <bind key="h"    action="tui.action.scroll left"          group="scroll" desc="Scroll left (vim)"/>
  <bind key="l"    action="tui.action.scroll right"         group="scroll" desc="Scroll right (vim)"/>
  <bind key="pgup" action="tui.action.page up"              group="scroll" desc="Page up"/>
  <bind key="pgdn" action="tui.action.page down"            group="scroll" desc="Page down"/>
  <bind key="home" action="tui.action.scroll_top"           group="scroll" desc="Top"/>
  <bind key="end"  action="tui.action.scroll_bottom"        group="scroll" desc="Bottom"/>

  <!-- help -->
  <bind key="f1" action="tui.action.text_keys" group="help" desc="Show the text-editing keys"/>

  <!-- click: left button on widgets and scrollbars -->
  <bind key="mouse:left" action="tui.action.click"          group="click" desc="Click"/>
  <bind key="drag:left"  action="tui.action.click"          group="click" desc="Drag scrollbar"/>

  <!-- wheel: plain = 3 lines, shift = 5 chars sideways, ctrl = exactly 1 line, ctrl+shift = exactly 1 char -->
  <bind key="wheel:up"    action="tui.action.scroll up 3"    group="wheel" desc="Scroll up 3 lines"/>
  <bind key="wheel:down"  action="tui.action.scroll down 3"  group="wheel" desc="Scroll down 3 lines"/>
  <bind key="wheel:left"  action="tui.action.scroll left 5"  group="wheel" desc="Scroll left"/>
  <bind key="wheel:right" action="tui.action.scroll right 5" group="wheel" desc="Scroll right"/>
  <bind key="shift+wheel:up"   action="tui.action.scroll left 5"  group="wheel" desc="Scroll left 5 chars"/>
  <bind key="shift+wheel:down" action="tui.action.scroll right 5" group="wheel" desc="Scroll right 5 chars"/>
  <bind key="ctrl+wheel:up"         action="tui.action.scroll up 1"    group="wheel" desc="Scroll up 1 line"/>
  <bind key="ctrl+wheel:down"       action="tui.action.scroll down 1"  group="wheel" desc="Scroll down 1 line"/>
  <bind key="ctrl+shift+wheel:up"   action="tui.action.scroll left 1"  group="wheel" desc="Scroll left 1 char"/>
  <bind key="ctrl+shift+wheel:down" action="tui.action.scroll right 1" group="wheel" desc="Scroll right 1 char"/>

  <!-- paste: bracketed paste goes into the focused input -->
  <bind key="paste" action="tui.action.paste" group="paste" always="true" desc="Paste into input"/>

  <!-- palette: the command bar -->
  <bind key="ctrl+p" action="tui.palette.open" group="palette" always="true" desc="Command palette"/>
  <bind key=":"      action="tui.palette.open" group="palette" desc="Command palette"/>

  <!-- pages -->
  <bind key="alt+backspace" action="tui.action.back" group="pages" desc="Back to the previous page"/>

  <!-- quit -->
  <bind key="q"      action="tui.action.quit" group="quit" desc="Quit"/>
  <bind key="ctrl+q" action="tui.action.quit" group="quit" always="true" desc="Quit (even while typing)"/>
</binds>
