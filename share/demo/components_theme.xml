<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="sc_tab_theme">
  <include src="_templates.xml"/>
  <script src="showcase_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <use template="dabt_header"/>
  <pane id="root1" weight="90" split="h">
    <pane id="sidebar" weight="18" split="v" border="none">
      <pane id="nav"      weight="58" title="Menu"  border="single" class="sidebar"/>
      <pane id="controls" weight="42" title="Theme" border="single" class="sidebar" hpad="1">
        <label  id="lbl_th_hd" text="Switch overlay:" class="muted_label"/>
        <button id="btn_sc_th_default" row="2" text="Default" action="sc_theme_pick" class="nav_link" align="fill"/>
        <button id="btn_sc_th_ocean" row="3" text="Ocean"   action="sc_theme_pick" class="nav_link" align="fill"/>
        <button id="btn_sc_th_forest" row="4" text="Forest"  action="sc_theme_pick" class="nav_link" align="fill"/>
        <button id="btn_sc_th_sunset" row="5" text="Sunset"  action="sc_theme_pick" class="nav_link" align="fill"/>
        <button id="btn_sc_th_light" row="6" text="Light"   action="sc_theme_pick" class="nav_link" align="fill"/>
      </pane>
    </pane>
    <pane id="main" split="v" border="single" weight="82" class="panel" hpad="1">
      <pane id="tabs_header" weight="5" border="none"/>
      <pane id="output" weight="95" border="heavy" class="panel" scroll="both"/>
    </pane>
  </pane>
  </pane>

  <tabs id="th_tabs" header_pane="tabs_header" content_pane="output" style="compact">
    <tab id="tab_renderers" text="Renderers"    action="sc_goto_renderers"/>
    <tab id="tab_theme"     text="Theme colors" action="sc_tab_here" default="true"/>
    <tab id="tab_fit"       text="Fit to size"  action="sc_goto_fit"/>
    <tab id="tab_live"      text="Live"         action="sc_goto_live"/>
  </tabs>


  <use template="dabt_nav"/>
</tui>
