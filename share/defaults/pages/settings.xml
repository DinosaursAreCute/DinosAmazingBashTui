<!-- DABT default Settings page (ships with the framework; palette: "DABT: Settings"). A sidebar of categories (collapses to a
     rail like the demo's menu), a search that filters every setting while you type, the settings of the chosen category and a
     details pane. Everything applies live and is saved through tui.config (see lib/config/tui_config.sh). An app can replace
     it: re-register the command id dabt.settings to point at its own page. -->
<tui on_visit="dset_visit">
  <script src="settings_callbacks.sh"/>
  <theme src="../theme.css"/>
  <footer items="@tui.action.back"/>

  <pane id="root" split="h" border="none">
    <pane id="side" weight="20" title="Settings" border="single" class="sidebar" collapsible="true" collapse_to="rail" default="expanded" resizable="x" handle="edge" keep_collapsed="true" keep_size="true"/>
    <pane id="main" split="v" weight="80" border="none">
      <pane id="search" weight="14" title="Search all settings   / focuses" border="single" class="panel" hpad="1">
        <input id="inp_search" placeholder="type to filter while you type" on_change="dset_search" submit="dset_search_enter"/>
      </pane>
      <pane id="body" split="h" weight="86" border="none">
        <pane id="items" weight="54" title="Appearance" border="single" class="panel">
          <list id="lst_items" rows="0" action="dset_activate" on_change="dset_moved"/>
        </pane>
        <pane id="desc" weight="46" title="Details" border="single" class="panel" hpad="1" scroll="v" resizable="x" handle="divider"/>
      </pane>
    </pane>
  </pane>

  <button id="cat_appearance"    pane="side" row="0" text="  Appearance"    action="dset_cat" class="nav_link" align="left" collapsed_text="AP"/>
  <button id="cat_input"         pane="side" row="1" text="  Input"         action="dset_cat" class="nav_link" align="left" collapsed_text="IN"/>
  <button id="cat_keybinds"      pane="side" row="2" text="  Keybinds"      action="dset_cat" class="nav_link" align="left" collapsed_text="KE"/>
  <button id="cat_notifications" pane="side" row="3" text="  Notifications" action="dset_cat" class="nav_link" align="left" collapsed_text="NO"/>
  <button id="cat_markdown"      pane="side" row="4" text="  Markdown"      action="dset_cat" class="nav_link" align="left" collapsed_text="MD"/>
  <button id="cat_plugins"       pane="side" row="5" text="  Plugins"       action="dset_cat" class="nav_link" align="left" collapsed_text="PL"/>
  <button id="btn_back"          pane="side" row="7" text="  Back"          action="tui.action.back" class="info_button" align="left" collapsed_text="BA"/>

  <!-- the per-element Markdown style: a color list, a hex field and the text attributes; every change applies at once -->
  <modal id="dlg_md_style" title="Customize style" split="h" x="center" y="center" width="60" height="17" open="false" class="panel" hpad="1" vpad="1">
    <pane id="ms_left" weight="50" border="none">
      <label id="ms_elem_lbl" text="" class="brand"/>
      <list  id="ms_colors" row="1" rows="8" items="default|black|red|green|yellow|blue|magenta|cyan|white|gray|bright_red|bright_green|bright_yellow|bright_blue|bright_magenta|bright_cyan|bright_white" on_change="dset_ms_color" action="dset_ms_color"/>
      <input id="ms_hex" row="10" label="Hex:" label_width="5" placeholder="#rrggbb" submit="dset_ms_hex"/>
    </pane>
    <pane id="ms_right" weight="50" border="none">
      <checkbox id="ms_bold"      label="Bold"      checked="false" action="dset_ms_mod" class="check"/>
      <checkbox id="ms_dim"       label="Dim"       checked="false" action="dset_ms_mod" class="check"/>
      <checkbox id="ms_italic"    label="Italic"    checked="false" action="dset_ms_mod" class="check"/>
      <checkbox id="ms_underline" label="Underline" checked="false" action="dset_ms_mod" class="check"/>
      <checkbox id="ms_reverse"   label="Reverse"   checked="false" action="dset_ms_mod" class="check"/>
      <checkbox id="ms_strike"    label="Strike"    checked="false" action="dset_ms_mod" class="check"/>
      <checkbox id="ms_bgmode" row="6" label="Edit the background" checked="false" action="dset_ms_target" class="check"/>
      <button id="ms_reset" row="8" text="[ Reset element ]" action="dset_ms_reset" class="danger_button" align="fill"/>
      <button id="ms_close" row="9" text="[ Close ]" action="dset_ms_close" class="info_button" align="fill"/>
    </pane>
  </modal>
</tui>
