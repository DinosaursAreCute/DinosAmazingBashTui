<tui shell="_shell.xml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="lab_visit">
  <script src="debug_tabs.sh"/>
  <script src="debug_lab_callbacks.sh"/>

  <pane id="main" split="v" border="none">
    <pane id="tabs_header" weight="5" border="none"/>
    <pane id="body" split="h" weight="95" border="none">
      <pane id="lab_buttons" weight="40" title="Trigger" border="single" class="panel" hpad="1">
        <label  id="lb_h1" text="Command bar &amp; overlays" class="brand"/>
        <button id="lb_pal" text="[ Open the command palette ]"        action="lab_palette"     class="info_button"    align="fill"/>
        <button id="lb_pal2" text="[ Palette pre-filled with 'theme ' ]" action="lab_palette_q"   class="info_button"    align="fill"/>
        <button id="lb_cmd" text="[ Register 'Lab: hello' (tui.cmd.add) ]" action="lab_cmd_add"   class="success_button" align="fill"/>
        <button id="lb_cmdrm" text="[ Remove it again ]"                 action="lab_cmd_remove"  class="warning_button" align="fill"/>
        <button id="lb_modal" text="[ Open a custom modal (tui.modal) ]" action="lab_modal_open"  class="success_button" align="fill"/>
        <button id="lb_ovl" text="[ Toggle an overlay box (tui.overlay) ]" action="lab_overlay_toggle" class="success_button" align="fill"/>
        <label  id="lb_h2" row="8" text="Modes" class="brand"/>
        <button id="lb_kill" row="9"  text="[ Keybinds off (kill-switch) ]"      action="lab_kill"        class="danger_button"  align="fill"/>
        <button id="lb_term" row="10" text="[ Terminal mode (pass-through) ]"    action="lab_term"        class="danger_button"  align="fill"/>
        <label  id="lb_h3" row="12" text="Focus &amp; pages" class="brand"/>
        <button id="lb_pn" row="13" text="[ Focus next pane ]"     action="lab_pane_next" class="info_button" align="fill"/>
        <button id="lb_pp" row="14" text="[ Focus previous pane ]" action="lab_pane_prev" class="info_button" align="fill"/>
        <button id="lb_pnav" row="15" text="[ Focus the menu pane ]" action="lab_pane_nav"  class="info_button" align="fill"/>
        <button id="lb_dset" row="16" text="[ Open DABT's default Settings page ]" action="lab_default_settings" class="success_button" align="fill"/>
        <button id="lb_dkb" row="17" text="[ Open DABT's default Keybinds page ]" action="lab_default_keybinds" class="success_button" align="fill"/>
        <label  id="lb_h4" row="19" text="Clipboard, paste and input focus" class="brand"/>
        <input  id="inp_clip" row="20" label="copy:"  label_width="8" placeholder="text for the clipboard (Enter copies)" submit="lab_copy"/>
        <input  id="inp_paste" row="21" label="paste:" label_width="8" placeholder="paste here (ctrl+shift+v): one event"/>
        <input  id="inp_keep" row="22" label="keeps:" label_width="8" placeholder="Enter submits, cursor stays" submit="lab_submit_keep"/>
        <input  id="inp_form" row="23" label="leaves:" label_width="8" placeholder="Enter submits, then leaves" submit="lab_submit_form" retain_input_on_submit="false"/>
      </pane>
      <pane id="lab_dialogs" weight="30" title="Dialogs &amp; toasts" border="single" class="panel" hpad="1">
        <!-- Dialogs and notifications (lib/chrome/tui_dialog.sh): callback style, the result lands in the log on the right -->
        <label  id="ld_h1" text="Dialogs" class="brand"/>
        <button id="ld_conf" text="[ Confirm ]"                action="lab_dlg_confirm"  class="info_button"    align="fill"/>
        <button id="ld_dang" text="[ Confirm (danger) ]"       action="lab_dlg_danger"   class="danger_button"  align="fill"/>
        <button id="ld_msg" text="[ Message ]"                action="lab_dlg_message"  class="info_button"    align="fill"/>
        <button id="ld_prompt" text="[ Prompt (digits only) ]"   action="lab_dlg_prompt"   class="success_button" align="fill"/>
        <button id="ld_choose" text="[ Choose a theme ]"         action="lab_dlg_choose"   class="success_button" align="fill"/>
        <button id="ld_chain" text="[ Chain: prompt then confirm ]" action="lab_dlg_chain" class="warning_button" align="fill"/>
        <label  id="ld_h2" row="8" text="Toasts (tui.notify)" class="brand"/>
        <button id="ld_ti" row="9"  text="[ info ]"            action="lab_toast_info"    class="info_button"    align="fill"/>
        <button id="ld_ts" row="10" text="[ success ]"         action="lab_toast_success" class="success_button" align="fill"/>
        <button id="ld_tw" row="11" text="[ warning ]"         action="lab_toast_warn"    class="warning_button" align="fill"/>
        <button id="ld_te" row="12" text="[ error, long text ]" action="lab_toast_error"  class="danger_button"  align="fill"/>
        <button id="ld_tk" row="13" text="[ sticky until cleared ]" action="lab_toast_sticky" class="sc_purple" align="fill"/>
        <button id="ld_tc" row="14" text="[ clear all ]"       action="lab_toast_clear"   class="warning_button" align="fill"/>
        <button id="ld_tg" row="15" text="[ toast, then change page ]" action="lab_toast_page" class="info_button" align="fill"/>
      </pane>
      <pane id="right" split="v" weight="30" border="none">
        <pane id="lab_state" weight="52" title="Live state (updates by itself)" border="single" class="panel" hpad="1" scroll="both"/>
        <pane id="lab_log"   weight="48" title="What happened" border="single" class="panel" hpad="1" scroll="v"/>
      </pane>
    </pane>
  </pane>

  <tabs id="lab_tabs" header_pane="tabs_header" content_pane="body" style="compact">
    <tab id="tab_dbg_events" text="Events &amp; hover"   action="dbg_goto_events"/>
    <tab id="tab_dbg_input"  text="Keyboard &amp; mouse" action="dbg_goto_input"/>
    <tab id="tab_dbg_lab"    text="Feature lab"          action="dbg_tab_here" default="true"/>
  </tabs>
</tui>
