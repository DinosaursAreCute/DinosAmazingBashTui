<tui shell="_shell.xml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="sc_tab_fit">
  <script src="showcase_callbacks.sh"/>

  <pane id="page_row" split="h" border="none">
    <pane id="controls" weight="22" title="Fit controls" border="single" class="sidebar" hpad="1">
      <checkbox id="chk_fit" label="Fit to pane" checked="true" action="on_toggle_fit" class="check"/>
      <label    id="lbl_fit_hd" row="2" text="Output pane:" class="muted_label"/>
      <button   id="btn_fit_border" row="3" text="Border: heavy (click)" action="on_fit_border" class="info_button" align="fill"/>
      <input    id="inp_fh" row="4" label="hpad:" label_width="7" placeholder="0-9" submit="on_fit_pad"/>
      <input    id="inp_fv" row="5" label="vpad:" label_width="7" placeholder="0-9" submit="on_fit_pad"/>
      <label    id="lbl_fit_tip" row="7" text="Resize the terminal too." class="muted_label"/>
    </pane>
    <pane id="main" split="v" border="single" weight="78" class="panel" hpad="1">
      <pane id="tabs_header" weight="5" border="none"/>
      <pane id="output" weight="95" border="heavy" class="panel" scroll="both"/>
    </pane>
  </pane>

  <tabs id="fit_tabs" header_pane="tabs_header" content_pane="output" style="compact">
    <tab id="tab_renderers" text="Renderers"    action="sc_goto_renderers"/>
    <tab id="tab_theme"     text="Theme colors" action="sc_goto_theme"/>
    <tab id="tab_fit"       text="Fit to size"  action="sc_tab_here" default="true"/>
    <tab id="tab_live"      text="Live"         action="sc_goto_live"/>
  </tabs>
</tui>
