<tui shell="_shell.xml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="tui.xsd" on_visit="on_monitor_visit">
  <script src="monitor_callbacks.sh"/>

  <pane id="main" split="v">

  <pane id="controls" title="System Monitoring Controls" split="grid" weight="8" rows="1" cols="6" fit="stretch" border="single" class="panel">
      <pane id="ctl_cpu"      border="none">
        <checkbox id="chk_mon_cpu" label="CPU"    checked="true" action="on_monitor_toggle_cpu" class="check"/>
      </pane>
      <pane id="ctl_mem"      border="none">
        <checkbox id="chk_mon_mem" label="Memory" checked="true" action="on_monitor_toggle_mem" class="check"/>
      </pane>
      <pane id="ctl_load"     border="none">
        <checkbox id="chk_mon_load" label="Load"   checked="true" action="on_monitor_toggle_load" class="check"/>
      </pane>
      <pane id="ctl_disk"     border="none">
        <checkbox id="chk_mon_disk" label="Disk"   checked="true" action="on_monitor_toggle_disk" class="check"/>
      </pane>
      <pane id="ctl_interval" border="none">
        <input  id="inp_mon_interval" label="Sec:" label_width="5" placeholder="1" submit="on_monitor_set_interval"/>
      </pane>
      <pane id="ctl_refresh"  border="none">
        <button id="btn_mon_refresh" text="[ Refresh ]" action="on_monitor_refresh" class="success_button" align="fill"/>
      </pane>
    </pane>

    <pane id="grid" split="grid" weight="86" rows="2" cols="2">
      <pane id="cpu_pane"  title="CPU Cores - vbar"          border="heavy" class="panel"/>
      <pane id="mem_pane"  title="Memory - gauge"            border="heavy" class="panel"/>
      <pane id="load_pane" title="Load Average - linechart"  border="heavy" class="panel"/>
      <pane id="disk_pane" title="Disk Usage &amp; I/O - hbar" border="heavy" class="panel"/>
    </pane>
  </pane>
</tui>
