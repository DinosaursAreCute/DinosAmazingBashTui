<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- Schema for the tui_markup.sh declarative TUI format (kept in step with the attributes the loader reads).
       Not schema-expressible: pane ids must be unique per page; a widget's pane must be a leaf; class names come
       from the loaded theme (.class, .class:focus/:hover/:border/:title/:checked/:unchecked). Not enforced at
       parse time (the loader is a lightweight bash regex parser) - this file
       exists purely so editors can offer autocompletion/validation.
       Roots: <tui> (a page), <binds> (keybind files), <cmds> (command palette files). <include> fragments with
       several top-level tags (e.g. _templates.xml) are not well-formed XML and can't be validated on their own. -->

  <xs:simpleType name="alignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="right"/>
      <xs:enumeration value="fill"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="valignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top"/>
      <xs:enumeration value="middle"/>
      <xs:enumeration value="bottom"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="splitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="h"/>
      <xs:enumeration value="v"/>
      <xs:enumeration value="grid"/>
      <xs:enumeration value="fixed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tabsStyleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="framed"/>
      <xs:enumeration value="compact"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pack"/>
      <xs:enumeration value="stretch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="boolType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="borderType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="single"/>
      <xs:enumeration value="double"/>
      <xs:enumeration value="heavy"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="titlePosType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top"/>
      <xs:enumeration value="bottom"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="titleAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="right"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="resizableType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="x"/>
      <xs:enumeration value="y"/>
      <xs:enumeration value="both"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="collapseToType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="title"/>
      <xs:enumeration value="0"/>
      <xs:enumeration value="rail"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="collapseDefaultType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="expanded"/>
      <xs:enumeration value="collapsed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="persistType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="session"/>
      <xs:enumeration value="disk"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:attributeGroup name="keepValueAttrs">
    <!-- keep_value: the widget's value, cursor, scroll and selection survive a page switch (session); persist: session (default) or disk (also written to $TUI_HOME/state/store; implies keeping) -->
    <xs:attribute name="keep_value" type="boolType"/>
    <xs:attribute name="persist" type="persistType"/>
  </xs:attributeGroup>

  <xs:attributeGroup name="keepSizeAttrs">
    <!-- keep_size: the pane's size after a resize survives a page switch (keep_collapsed is in collapseAttrs) -->
    <xs:attribute name="keep_size" type="boolType"/>
    <xs:attribute name="persist" type="persistType"/>
  </xs:attributeGroup>

  <xs:attributeGroup name="collapseAttrs">
    <!-- collapsible: chevron on the title, tui.collapse works; default / collapsed (alias, must agree): first-build state;
         keep_collapsed: kept across page switches; collapse_to: title = one row / title-wide column, 0 = nothing, rail = buttons' collapsed_text;
         on_toggle: FN PANE STATE (collapsed|expanded); collapse_key: a key name (ctrl+1, alt+c, f5) that toggles the pane from anywhere on the page;
         collapse_class: theme class of the button (default collapse_button, with :hover and :collapsed) -->
    <xs:attribute name="collapsible" type="boolType"/>
    <xs:attribute name="default" type="collapseDefaultType"/>
    <xs:attribute name="collapsed" type="boolType"/>
    <xs:attribute name="keep_collapsed" type="boolType"/>
    <xs:attribute name="collapse_to" type="collapseToType"/>
    <xs:attribute name="on_toggle" type="xs:string"/>
    <xs:attribute name="collapse_key" type="xs:string"/>
    <xs:attribute name="collapse_class" type="xs:string"/>
  </xs:attributeGroup>

  <xs:simpleType name="handleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="corner"/>
      <xs:enumeration value="edge"/>
      <xs:enumeration value="divider"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="scrollType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="v"/>
      <xs:enumeration value="h"/>
      <xs:enumeration value="both"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="scopeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="global"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Everything a page may contain. The loader reads one tag per line with no parent tracking (widgets attach
       via pane="…", not by nesting), so the same set is valid at <tui> level and inside any <pane>. -->
  <xs:group name="pageContent">
    <xs:choice>
      <xs:element ref="script"/>
      <xs:element ref="theme"/>
      <xs:element ref="include"/>
      <xs:element ref="pane"/>
      <xs:element ref="details"/>
      <xs:element ref="accordion"/>
      <xs:element ref="tabs"/>
      <xs:element ref="bind"/>
      <xs:element ref="footer"/>
      <xs:element ref="label"/>
      <xs:element ref="button"/>
      <xs:element ref="input"/>
      <xs:element ref="password"/>
      <xs:element ref="textarea"/>
      <xs:element ref="checkbox"/>
      <xs:element ref="list"/>
      <xs:element ref="table"/>
      <xs:element ref="select"/>
      <xs:element ref="progress"/>
      <xs:element ref="template"/>
      <xs:element ref="use"/>
      <xs:element ref="slot"/>
      <xs:element ref="fill"/>
      <xs:element ref="for"/>
      <xs:element ref="if"/>
      <xs:element ref="component"/>
      <xs:element ref="addon"/>
    </xs:choice>
  </xs:group>

  <xs:element name="footer">
    <xs:annotation><xs:documentation>One-row key-hint bar drawn on the last terminal row wherever it is declared. items = "KEY|Label[|WHEN_FN];..."; KEY may be "@tui.action.name" to show the key currently bound to that action.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attribute name="items" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="bind">
    <xs:complexType>
      <xs:attribute name="key" type="xs:string" use="required"/>
      <xs:attribute name="action" type="xs:string" use="required"/>
      <xs:attribute name="scope" type="scopeType"/>
      <xs:attribute name="pane" type="xs:string"/>
      <xs:attribute name="group" type="xs:string"/>
      <xs:attribute name="pass" type="boolType"/>
      <xs:attribute name="always" type="boolType"/>
      <xs:attribute name="desc" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Keybind files: share/defaults/keybinds.xml (tui.bind.defaults, group= is the opt-out unit) and the user
       file written by tui.bind.save. One <bind> per line. -->
  <xs:element name="binds">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="bind" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Command palette files (tui.cmd.load, e.g. share/defaults/commands.xml). One <cmd> per line. -->
  <xs:element name="cmds">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="cmd" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="cmd">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
      <!-- function + args; several may be chained with ';' -->
      <xs:attribute name="action" type="xs:string" use="required"/>
      <xs:attribute name="group" type="xs:string"/>
      <xs:attribute name="desc" type="xs:string"/>
      <!-- function name: the command is listed only while it succeeds -->
      <xs:attribute name="when" type="xs:string"/>
      <xs:attribute name="key" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- focus and hit attributes every widget accepts (lib/input/tui_focus.sh, tui_hit.sh) -->
  <xs:attributeGroup name="focusHitAttrs">
    <xs:attribute name="focusable" type="boolType"/>
    <xs:attribute name="tabbable" type="boolType"/>
    <xs:attribute name="tab_order" type="xs:integer"/>
    <xs:attribute name="focus_group" type="xs:string"/>
    <xs:attribute name="focus_nav">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="arrows"/>
          <xs:enumeration value="tab"/>
          <xs:enumeration value="both"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="focus_wrap" type="boolType"/>
    <xs:attribute name="focus_next" type="xs:string"/>
    <xs:attribute name="focus_prev" type="xs:string"/>
    <xs:attribute name="autofocus" type="boolType"/>
    <!-- keep_focus: when this widget has the focus as the page is left, focus lands on the same id on the next page (if it has it) -->
    <xs:attribute name="keep_focus" type="boolType"/>
    <xs:attribute name="hit_pad" type="xs:string"/>
    <xs:attribute name="hitbox" type="xs:string"/>
  </xs:attributeGroup>

  <xs:element name="tui">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="on_visit" type="xs:string"/>
      <!-- comma/space separated default keybind groups to switch off for this page, e.g. "-quit,-scroll" -->
      <xs:attribute name="defaults" type="xs:string"/>
      <xs:attribute name="focus_wrap" type="boolType"/>
      <!-- keep_state: every widget and pane of the page keeps value, cursor, scroll, selection, collapsed and size across page switches -->
      <xs:attribute name="keep_state" type="boolType"/>
      <xs:attribute name="persist" type="persistType"/>
      <!-- focus_on_enter: first (default), keep (the id focused when the page was last left) or the id of a widget -->
      <xs:attribute name="focus_on_enter" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="script">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="theme">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="include">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="template">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="use">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="template" type="xs:string" use="required"/>
      <xs:attribute name="id" type="xs:string"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="slot">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="fill">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="slot" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="for">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="each" type="xs:string"/>
      <xs:attribute name="count" type="xs:string"/>
      <xs:attribute name="as" type="xs:string"/>
      <xs:attribute name="index" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="if">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
        <xs:element ref="else"/>
      </xs:choice>
      <xs:attribute name="test" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="else">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="component">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="addon">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="append"/>
        <xs:element ref="prepend"/>
        <xs:element ref="before"/>
        <xs:element ref="after"/>
        <xs:element ref="replace"/>
        <xs:element ref="remove"/>
        <xs:element ref="set"/>
        <xs:element ref="wrap"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="target" type="xs:string"/>
      <xs:attribute name="priority" type="xs:string"/>
      <xs:attribute name="prefix" type="boolType"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="append">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="prepend">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="before">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="after">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="replace">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="remove">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="set">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:string" use="required"/>
      <xs:attribute name="attr" type="xs:string" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="wrap">
    <xs:complexType>
      <xs:attribute name="ref" type="xs:string" use="required"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="pane">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <!-- width/height/gap: size tokens - N cells, N%, Nfr, fill, clamp(MIN,PREF,MAX); weight="N" is the same as Nfr -->
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="split" type="splitType"/>
      <xs:attribute name="weight" type="xs:positiveInteger"/>
      <xs:attribute name="title" type="xs:string"/>
      <xs:attribute name="border" type="borderType"/>
      <!-- fuse: on every child of a split - siblings share one border line; divider/divider_class style that line -->
      <xs:attribute name="fuse" type="boolType"/>
      <xs:attribute name="divider" type="borderType"/>
      <xs:attribute name="divider_class" type="xs:string"/>
      <xs:attribute name="title_pos" type="titlePosType"/>
      <xs:attribute name="title_align" type="titleAlignType"/>
      <!-- resizable: axes the user may resize on; handle: mouse zones (none = keyboard only); on_resize: FN PANE W H -->
      <xs:attribute name="resizable" type="resizableType"/>
      <xs:attribute name="handle" type="handleType"/>
      <xs:attribute name="on_resize" type="xs:string"/>
      <xs:attributeGroup ref="collapseAttrs"/>
      <xs:attributeGroup ref="keepSizeAttrs"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="scroll" type="scrollType"/>
      <xs:attribute name="scroll_into_view" type="boolType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="min_height" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_height" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="strict_fit" type="boolType"/>
      <!-- split="fixed" only: every child is exactly size_w x size_h cells, flowed left to right and wrapped (tui.fixed) -->
      <xs:attribute name="size_w" type="xs:positiveInteger"/>
      <xs:attribute name="size_h" type="xs:positiveInteger"/>
      <!-- direct child of a split="fixed" parent only: width in cell units, and force a new row before this child -->
      <xs:attribute name="span" type="xs:positiveInteger"/>
      <xs:attribute name="newline" type="boolType"/>
      <!-- split="grid" only -->
      <xs:attribute name="rows" type="xs:positiveInteger"/>
      <xs:attribute name="cols" type="xs:positiveInteger"/>
      <xs:attribute name="fit" type="fitType"/>
      <xs:attribute name="row_weights" type="xs:string"/>
      <xs:attribute name="col_weights" type="xs:string"/>
      <!-- direct child of a split="grid" parent only -->
      <xs:attribute name="grid_row" type="xs:nonNegativeInteger"/>
      <xs:attribute name="grid_col" type="xs:nonNegativeInteger"/>
      <xs:attribute name="width" type="xs:string"/>
      <xs:attribute name="height" type="xs:string"/>
      <xs:attribute name="gap" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="label">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="text" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="width" type="xs:string"/>
      <xs:attribute name="height" type="xs:string"/>
      <xs:attribute name="padding" type="xs:string"/>
      <xs:attribute name="pin">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="top"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="focusHitAttrs"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="input">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="label" type="xs:string"/>
      <xs:attribute name="placeholder" type="xs:string"/>
      <xs:attribute name="submit" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="label_align" type="alignType"/>
      <xs:attribute name="retain_input_on_submit" type="boolType"/>
      <xs:attribute name="sticky" type="boolType"/>
      <xs:attribute name="label_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="width" type="xs:string"/>
      <xs:attribute name="height" type="xs:string"/>
      <xs:attribute name="padding" type="xs:string"/>
      <xs:attribute name="min_height" type="xs:string"/>
      <xs:attribute name="max_height" type="xs:string"/>
      <xs:attribute name="expand">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="x"/>
            <xs:enumeration value="y"/>
            <xs:enumeration value="both"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="pin">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="top"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attributeGroup ref="focusHitAttrs"/>
      <xs:attributeGroup ref="keepValueAttrs"/>
    </xs:complexType>
  </xs:element>

  <!-- details: a collapsible pane (chevron on its title); in an accordion, opening one collapses the others -->
  <xs:element name="details">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="pageContent"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="title" type="xs:string"/>
      <xs:attribute name="split" type="splitType"/>
      <xs:attribute name="weight" type="xs:positiveInteger"/>
      <xs:attribute name="width" type="xs:string"/>
      <xs:attribute name="height" type="xs:string"/>
      <xs:attribute name="border" type="borderType"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="min_height" type="xs:nonNegativeInteger"/>
