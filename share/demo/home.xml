<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd">
  <include src="_templates.xml"/>
  <script src="demo_callbacks.sh"/>
  <theme src="theme.css"/>
  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <use template="dabt_header"/>
    <pane id="root1" weight="90" split="h">
      <pane id="nav" weight="18" title="Menu" border="single" class="sidebar"/>
      <pane id="main" split="v" weight="82">
        <pane id="welcome" weight="95" title="Welcome" border="heavy" class="panel" hpad="2">
          <label id="lbl_title" text="DinosAmazingBashTui" class="brand" align="center"/>
          <label id="lbl_sub" row="2" text="A declarative, file-based terminal UI framework in pure bash." align="center"/>
          <label id="lbl_sub2" row="3" text="Only bash + POSIX utils + awk. No Python, Node or ncurses. I use arch btw :D" align="center" class="muted_label"/>
          <label id="lbl_warn" row="5" text=" experimental - expect rough edges " align="center" class="warning_button"/>
          <label id="lbl_tour_hd" row="7"  text="Where to go" class="brand"/>
          <label id="lbl_t1" row="8"  text="  Components  every renderer, theme colors, fit-to-size, live updating tab"/>
          <label id="lbl_t2" row="9"  text="  Settings    switch themes app-wide, borders, padding, fonts - saved to disk"/>
          <label id="lbl_t3" row="10" text="  Monitor     CPU / memory / load / disk sampled straight from /proc"/>
          <label id="lbl_t4" row="11" text="  Terminal    a real bash session running inside a pane (PTY)"/>
          <label id="lbl_t5" row="12" text="  Scrolling   wheel, drag, and vim keys on huge panes (AWK shader)"/>
          <label id="lbl_t6" row="13" text="  Case Study  a benchmark-style page built from the same parts"/>
          <label id="lbl_t7" row="14" text="  Docs        the design write-ups, one tab per file"/>
          <label id="lbl_t8" row="15" text="  Layout      alignment, min/max sizing, padding, layered borders"/>
          <label id="lbl_t9" row="16" text="  Styles      theme classes and their hover / focus states"/>
          <label id="lbl_t10" row="17" text="  Debug       live input tape, hover/focus readout, dynamic grid"/>
          <label id="lbl_cta" row="19" text="Tab / arrows / mouse to move, Enter or click to activate." align="center" class="muted_label"/>
        </pane>
        <pane id="footer" weight="5" border="single" class="panel">
          <label id="lbl_footer" text="DinosAmazingBashTui v0.1.0" align="center" class="muted_label"/>
        </pane>
      </pane>
    </pane>
  </pane>




  <use template="dabt_nav"/>
</tui>
