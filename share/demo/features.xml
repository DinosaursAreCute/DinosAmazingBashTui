<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd">
  <script src="demo_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <include src="_header.xml"/>
  <pane id="root1" weight="90" split="h">
    <pane id="nav" weight="18" title="Menu" border="single" class="sidebar"/>
    <pane id="main" split="v" weight="82" border="none">
      <pane id="row1" split="h" weight="50" border="none">
        <pane id="align_demo" weight="50" title="Alignment (align / valign)" class="panel" hpad="1"/>
        <pane id="input_demo" weight="50" title="Input label alignment"      class="panel" hpad="1"/>
      </pane>
      <pane id="row2" split="h" weight="50" border="none">
        <!-- a framed PARENT with hpad/vpad: children keep their distance, borders layer -->
        <pane id="layer_demo" split="h" weight="50" title="Layered borders + hpad/vpad on a parent" border="double" class="panel" hpad="2" vpad="1">
          <pane id="layer_a" weight="1" title="child A" border="single" class="panel"/>
          <pane id="layer_b" weight="1" title="child B" border="single" class="panel"/>
        </pane>
        <pane id="pad_demo" weight="25" title="Leaf pad: hpad=3 vpad=1" class="panel" hpad="3" vpad="1"/>
        <pane id="tiny_demo" weight="25" title="Min size warning" min_width="999" min_height="999" class="panel"/>
      </pane>
    </pane>
  </pane>
  </pane>

  <label  id="lbl_align_left"   pane="align_demo" row="0" text="left-aligned text"   align="left"/>
  <label  id="lbl_align_center" pane="align_demo" row="1" text="center-aligned text" align="center"/>
  <label  id="lbl_align_right"  pane="align_demo" row="2" text="right-aligned text"  align="right"/>
  <button id="btn_align_fill"   pane="align_demo" row="4" text="[ align=fill button ]" action="on_noop" class="success_button" align="fill"/>
  <label  id="lbl_valign_note"  pane="align_demo" row="6" text="valign: top / middle / bottom" class="muted_label"/>

  <input id="inp_feat_a" pane="input_demo" row="0" label="Name:" label_width="12" label_align="right" placeholder="right-aligned label"/>
  <input id="inp_feat_b" pane="input_demo" row="1" label="Bio:"  label_width="12" label_align="left"  placeholder="left-aligned label"/>
  <label id="lbl_template" pane="input_demo" row="3" text="${terminal_renderer.sh divider -s 'runtime ${} template'}"/>

  <label id="lbl_pad1" pane="pad_demo" row="0" text="hpad/vpad move the content"/>
  <label id="lbl_pad2" pane="pad_demo" row="1" text="away from the frame."/>
  <label id="lbl_pad3" pane="pad_demo" row="3" text="widgets take their own" class="muted_label"/>
  <label id="lbl_pad4" pane="pad_demo" row="4" text="hpad/vpad too." class="muted_label" hpad="2"/>

  <include src="_nav.xml"/>
</tui>
