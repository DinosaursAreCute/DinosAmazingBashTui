<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd">
  <include src="_templates.xml"/>
  <script src="demo_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <use template="dabt_header"/>
    <pane id="root1" weight="90" split="h">
      <pane id="nav" weight="18" title="Menu" border="single" class="sidebar"/>
      <pane id="main" split="v" weight="82" border="none">
        <pane id="buttons_demo"  weight="34" title="Button classes - hover and click them (:hover / :focus states)" class="panel" hpad="1">
          <button id="btn_style_info" text="[ Info    ]"  action="on_noop" class="info_button"    align="fill"/>
          <button id="btn_style_success" text="[ Success ]"  action="on_noop" class="success_button" align="fill"/>
          <button id="btn_style_warning" text="[ Warning ]"  action="on_noop" class="warning_button" align="fill"/>
          <button id="btn_style_danger" text="[ Danger  ]"  action="on_noop" class="danger_button"  align="fill"/>
        </pane>
        <pane id="swatches_demo" weight="38" title="Color swatches" class="panel" hpad="1">
          <label id="lbl_swatch_red" text="  #e53e3e  swatch_red"     class="swatch_red"     align="fill"/>
          <label id="lbl_swatch_green" text="  #38a169  swatch_green"   class="swatch_green"   align="fill"/>
          <label id="lbl_swatch_blue" text="  #3182ce  swatch_blue"    class="swatch_blue"    align="fill"/>
          <label id="lbl_swatch_yellow" text="  #ecc94b  swatch_yellow"  class="swatch_yellow"  align="fill"/>
          <label id="lbl_swatch_magenta" text="  #d53f8c  swatch_magenta" class="swatch_magenta" align="fill"/>
          <label id="lbl_swatch_cyan" text="  #319795  swatch_cyan"    class="swatch_cyan"    align="fill"/>
        </pane>
        <pane id="hint_demo"     weight="28" title="Try it" class="panel" hpad="1">
          <label id="lbl_hint1" text="Classes live in theme.css: .name { fg; bg; mods } plus :hover :focus :border :title."/>
        </pane>
      </pane>
    </pane>
  </pane>



  <label id="lbl_hint2" pane="hint_demo" row="1" text="Settings switches the whole app to another palette; Components > Theme colors lists every class." class="muted_label"/>
  <use template="dabt_nav"/>
</tui>
