<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="sc_tab_renderers">
  <script src="showcase_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <include src="_header.xml"/>
  <pane id="root1" weight="90" split="h">
    <pane id="sidebar" weight="22" split="v" border="none">
      <pane id="nav"      weight="58" title="Menu"     border="single" class="sidebar"/>
      <pane id="controls" weight="42" title="Controls" border="single" class="sidebar" hpad="1"/>
    </pane>
    <!-- main is a PARENT with its own frame + hpad: the layered-border demo
         (main single -> output heavy). Borders drop automatically on tiny terminals. -->
    <pane id="main" split="v" border="single" weight="78" class="panel" hpad="1">
      <pane id="tabs_header" weight="5" border="none"/>
      <pane id="toolbarContainer" split="v" weight="14" border="none">
        <pane id="toolbar" split="h" weight="1" border="none">
          <pane id="tb_box"     weight="1" border="none"/>
          <pane id="tb_divider" weight="1" border="none"/>
          <pane id="tb_alert"   weight="1" border="none"/>
          <pane id="tb_table"   weight="1" border="none"/>
          <pane id="tb_kv"      weight="1" border="none"/>
          <pane id="tb_hbar"    weight="1" border="none"/>
        </pane>
        <pane id="toolbar2" weight="1" split="h" border="none">
          <pane id="tb_banner"  weight="1" border="none"/>
          <pane id="tb_tree"    weight="1" border="none"/>
          <pane id="tb_columns" weight="1" border="none"/>
          <pane id="tb_badges"  weight="1" border="none"/>
          <pane id="tb_list"    weight="1" border="none"/>
          <pane id="tb_quote"   weight="1" border="none"/>
          <pane id="tb_all"     weight="1" border="none"/>
        </pane>
        <pane id="toolbar3" weight="1" split="h" border="none">
          <pane id="tb_gauge"   weight="1" border="none"/>
          <pane id="tb_spark"   weight="1" border="none"/>
          <pane id="tb_vbar"    weight="1" border="none"/>
          <pane id="tb_line"    weight="1" border="none"/>
          <pane id="tb_csv"     weight="1" border="none"/>
        </pane>
      </pane>
      <pane id="output" weight="81" border="heavy" class="panel" scroll="both"/>
    </pane>
  </pane>
  </pane>

  <!-- One page per tab, so each tab only shows the controls that apply to it. -->
  <tabs id="sc_tabs" header_pane="tabs_header" content_pane="output" style="compact">
    <tab id="tab_renderers" text="Renderers"    action="sc_tab_here" default="true"/>
    <tab id="tab_theme"     text="Theme colors" action="sc_goto_theme"/>
    <tab id="tab_fit"       text="Fit to size"  action="sc_goto_fit"/>
    <tab id="tab_live"      text="Live"         action="sc_goto_live"/>
  </tabs>

  <!-- Toolbar row 1 -->
  <button id="btn_box"     pane="tb_box"     row="0" text="[ Box ]"     action="show_box"     class="info_button"    align="fill"/>
  <button id="btn_divider" pane="tb_divider" row="0" text="[ Divider ]" action="show_divider" class="success_button" align="fill"/>
  <button id="btn_alert"   pane="tb_alert"   row="0" text="[ Alert ]"   action="show_alert"   class="warning_button" align="fill"/>
  <button id="btn_table"   pane="tb_table"   row="0" text="[ Table ]"   action="show_table"   class="danger_button"  align="fill"/>
  <button id="btn_kv"      pane="tb_kv"      row="0" text="[ KV ]"      action="show_kv"      class="info_button"    align="fill"/>
  <button id="btn_hbar"    pane="tb_hbar"    row="0" text="[ Bar ]"     action="show_hbar"    class="success_button" align="fill"/>

  <!-- Toolbar row 2 -->
  <button id="btn_banner"  pane="tb_banner"  row="0" text="[ Banner ]"  action="show_banner"  class="sc_purple"      align="fill"/>
  <button id="btn_tree"    pane="tb_tree"    row="0" text="[ Tree ]"    action="show_tree"    class="warning_button" align="fill"/>
  <button id="btn_columns" pane="tb_columns" row="0" text="[ Columns ]" action="show_columns" class="danger_button"  align="fill"/>
  <button id="btn_badges"  pane="tb_badges"  row="0" text="[ Badges ]"  action="show_badges"  class="info_button"    align="fill"/>
  <button id="btn_list"    pane="tb_list"    row="0" text="[ List ]"    action="show_list"    class="success_button" align="fill"/>
  <button id="btn_quote"   pane="tb_quote"   row="0" text="[ Quote ]"   action="show_quote"   class="sc_purple"      align="fill"/>
  <button id="btn_all"     pane="tb_all"     row="0" text="[ ALL ]"     action="show_all"     class="danger_button"  align="fill"/>

  <!-- Toolbar row 3: charts -->
  <button id="btn_gauge"   pane="tb_gauge"   row="0" text="[ Gauge ]"     action="show_gauge"     class="success_button" align="fill"/>
  <button id="btn_spark"   pane="tb_spark"   row="0" text="[ Sparkline ]" action="show_sparkline" class="info_button"    align="fill"/>
  <button id="btn_vbar"    pane="tb_vbar"    row="0" text="[ VBar ]"      action="show_vbar"      class="warning_button" align="fill"/>
  <button id="btn_line"    pane="tb_line"    row="0" text="[ Line ]"      action="show_linechart" class="sc_purple"      align="fill"/>
  <button id="btn_csv"     pane="tb_csv"     row="0" text="[ CSV ]"       action="show_csv"       class="danger_button"  align="fill"/>

  <!-- Controls sidebar: widgets that drive the renderers -->
  <label    id="lbl_current" pane="controls" row="0" text="Current:" class="muted_label"/>
  <label    id="lbl_status"  pane="controls" row="1" text="—" class="brand"/>
  <checkbox id="chk_fit"     pane="controls" row="2" label="Fit to pane" checked="true" action="on_toggle_fit"/>
  <!-- rows 4-8: options for the current view, built at runtime (_sc_controls) -->
  <button   id="btn_clear"   pane="controls" row="10" text="[ Clear ]" action="on_clear" class="danger_button" align="fill"/>

  <include src="_nav.xml"/>
</tui>
