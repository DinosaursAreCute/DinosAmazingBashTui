#!/usr/bin/env bash
# dabt - the DABT command. Without arguments it shows this help.
# Works from an installed copy (~/.local/bin/dabt is a link to it) and from a git checkout.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do l="$(readlink "$SELF")"; [[ "$l" == /* ]] && SELF="$l" || SELF="$(dirname "$SELF")/$l"; done
export TUI_ROOT="$(cd -P "$(dirname "$SELF")/.." && pwd -P)"

_help() {
    cat <<HELP
dabt - DinosAmazingBashTui

Usage: dabt [option | command]

Options:
  -h, --help       show this help (also the default without arguments)
  -d, --details    installed version, locations and status
  -v, --version    print the version
      --demo       run the demo application

Commands:
  update [--check] [--path PATH] [--yes] [--dev] [--policy override|skip|new] [--force] [--no-scan]   update to the latest release, or from a local file/folder with --path (dabt update --help)
  install [install.sh options]                            install this copy (see install.sh --help)
  doctor                                                  same as --details
  scan PATH... [--deep] [--strict]                        security-scan scripts (dabt scan --tools / --install)
  app <command>                                           install and manage DABT applications (dabt app help)
  build [DIR] [options]                                   package an application into a signed .dapk (dabt pkg help)
  pkg <command>                                           verify, inspect, release and publish packages (dabt pkg help)
  clear-cache                                             delete the page cache (rebuilt on next run)
  reinstall [--yes]                                       reinstall from the install source, overriding local file changes
  uninstall [--yes] [--keep-config] [--keep-apps] [--purge-keys]   remove the program, config home, the dabt command and every app installed with dabt
HELP
}

_meta() { local k v; [[ -r "$1/install.meta" ]] && while IFS='=' read -r k v; do [[ "$k" == "$2" ]] && printf '%s' "$v"; done < "$1/install.meta"; }

_confirm() { (( ${yes:-0} )) && return 0; local a; read -r -p "$1 [y/N] " a; [[ "$a" == [yY]* ]]; }

_clear_cache() {
    # shellcheck source=../lib/tui_home.sh
    source "$TUI_ROOT/lib/tui_home.sh";
    if [[ -d "$TUI_HOME/cache" ]]; then 
        rm -rf "$TUI_HOME/cache" && echo "cleared $TUI_HOME/cache"; 
    else 
        echo "no cache at $TUI_HOME/cache"; 
    fi
}

_reinstall() {
    # shellcheck source=../lib/tui_home.sh
    source "$TUI_ROOT/lib/tui_home.sh"
    local src; src="$(_meta "$TUI_HOME" source)"
    [[ -f "$src/install.sh" ]] || src="$TUI_ROOT"
    [[ -f "$src/install.sh" ]] || { echo "dabt: install.sh not found (looked in '$src'); reinstall from a checkout: ./install.sh" >&2; exit 1; }
    _confirm "Reinstall DABT from $src (local changes to defaults/plugins are overridden)?" || { echo aborted; exit 1; }
    exec bash "$src/install.sh" --yes --policy override "$@"
}

_uninstall() {
    # shellcheck source=../lib/tui_home.sh
    source "$TUI_ROOT/lib/tui_home.sh"
    local keep_conf=0 keep_apps=0 purge_keys=0 a prefix conf bindir targets=() apps=() l n v d rest keys_dir keys_bak
    for a in "$@"; do case "$a" in --keep-config) keep_conf=1 ;; --keep-apps) keep_apps=1 ;; --purge-keys) purge_keys=1 ;; esac; done
    conf="$TUI_HOME"; prefix="$(_meta "$conf" prefix)"; [[ -n "$prefix" ]] || prefix="$TUI_ROOT"; bindir="$(_meta "$conf" bindir)"
    [[ -e "$prefix/.git" ]] && { echo "dabt: $prefix is a git checkout - not removing the program folder" >&2; prefix=""; }
    [[ "$conf" == / || "$conf" == "$HOME" || -z "$conf" ]] && { echo "dabt: refusing to remove '$conf'" >&2; exit 1; }
    # apps installed with `dabt app install` (not the built-in demo): removed through `dabt app remove --purge`, which runs their uninstall hook
    if (( ! keep_apps )) && [[ -r "$conf/apps.list" ]]; then
        while IFS='|' read -r n v d rest; do [[ -n "$n" && "$n" != \#* && "$rest" != builtin* && "${rest#*|}" != builtin* ]] && apps+=("$n|$d"); done < "$conf/apps.list"
    fi
    [[ -n "$prefix" ]] && targets+=("$prefix")
    (( keep_conf )) || targets+=("$conf")
    # launchers: the recorded bindir, ~/.local/bin, and whatever `dabt` on PATH points into this install
    for l in "${bindir:+$bindir/dabt}" "$HOME/.local/bin/dabt" "$(command -v dabt 2>/dev/null)"; do
        [[ -n "$l" && -L "$l" ]] || continue
        [[ " ${targets[*]} " == *" $l "* ]] && continue
        [[ "$(readlink -f "$l")" == "$(readlink -f "$TUI_ROOT/bin/dabt")" || "$(readlink -f "$l")" == "$(readlink -f "$prefix/bin/dabt" 2>/dev/null)" ]] && targets+=("$l")
    done
    keys_dir="$conf/keys"
    printf 'Will remove:\n'; printf '  %s\n' "${targets[@]}"
    for a in "${apps[@]}"; do printf '  app %s (%s) and its settings\n' "${a%%|*}" "${a#*|}"; done
    if (( ! keep_conf && ! purge_keys )) && [[ -n "$(ls -A "$keys_dir" 2>/dev/null)" ]]; then
        keys_bak="$HOME/.dabt-keys-backup"
        printf '\nYour signing keys in %s are NOT deleted: they move to %s (delete it yourself, or use --purge-keys).\n' "$keys_dir" "$keys_bak"
    fi
    _confirm "Uninstall DABT?" || { echo aborted; exit 1; }
    if (( ${#apps[@]} )); then
        # shellcheck source=../lib/apps/tui_apps.sh
        source "$TUI_ROOT/lib/apps/tui_apps.sh"
        for a in "${apps[@]}"; do
            n="${a%%|*}"; d="${a#*|}"
            tui.apps.remove "$n" --yes --purge >/dev/null 2>&1 || echo "note: could not remove app $n cleanly"
            [[ -n "$d" && -d "$d" ]] && { _tui_apps.managed "$d" 2>/dev/null && rm -rf -- "$d"; }
            echo "removed app $n"
        done
        rmdir "$TUI_APPS_OWN_ROOT" 2>/dev/null && echo "removed $TUI_APPS_OWN_ROOT"      # the shared own_dir folder, when nothing else lives there
    fi
    if [[ -n "${keys_bak:-}" ]]; then
        mkdir -p "$keys_bak" && chmod 700 "$keys_bak" && cp -a "$keys_dir"/. "$keys_bak"/ && echo "kept signing keys in $keys_bak" || { echo "dabt: could not back up $keys_dir - leaving the config in place" >&2; exit 1; }
    fi
    for l in "${targets[@]}"; do rm -rf -- "$l" && echo "removed $l"; done
    [[ -n "${DABT_HOME:-}${TUI_HOME_ENV:-}" ]] && echo "note: DABT_HOME is set in your environment - remove it from your shell profile"
    echo "done. Variables live only in the running shell; open a new terminal to clear any leftovers."
}

_details() {
    # shellcheck source=../lib/tui.sh
    # shellcheck source=../lib/terminal_renderer.sh
    source "$TUI_ROOT/lib/tui.sh"; source "$TUI_ROOT/lib/terminal_renderer.sh"
    local rows=(
        "Version: $TUI_VERSION"
        "Program: $TUI_ROOT$([[ -e "$TUI_ROOT/.git" ]] && echo ' (git checkout)')"
        "Config home: $TUI_HOME"
        "Found via: $TUI_HOME_SOURCE"
        "Installed: $([[ $TUI_INSTALLED == 1 ]] && echo yes || echo 'no - run: dabt install')"
        "Defaults: $TUI_DEFAULTS_DIR"
        "Plugins: $TUI_PLUGINS_DIR"
    )
    local n; n=$(compgen -G "$TUI_PLUGINS_DIR/*.plugin.sh" 2>/dev/null | wc -l); rows+=("Plugin files: $n")
    [[ -r "$TUI_HOME/install.meta" ]] && while IFS='=' read -r k v; do [[ -n "$k" && "$k" != \#* ]] && rows+=("meta $k: $v"); done < "$TUI_HOME/install.meta"
    kv "${rows[@]}"
}

case "${1:-}" in
    "")                     _help ;;
    -h|--help|help)         _help ;;
    --demo|demo)            shift; exec bash "$TUI_ROOT/bin/DABT_demo.sh" "$@" ;;
    -d|--details|doctor|paths) _details ;;
    -v|--version|version)   read -r v < "$TUI_ROOT/VERSION"; echo "DABT $v" ;;
    install)                shift; exec bash "$TUI_ROOT/install.sh" "$@" ;;
    app)
        shift
        # shellcheck source=../lib/apps/tui_apps.sh
        source "$TUI_ROOT/lib/apps/tui_apps.sh"
        tui.apps.cli "$@"; exit $?
        ;;
    build)
        shift
        # shellcheck source=../lib/dapk/dapk.sh
        source "$TUI_ROOT/lib/dapk/dapk.sh"
        dapk.cmd.build "$@"; exit $?
        ;;
    pkg)
        shift
        # shellcheck source=../lib/dapk/dapk.sh
        source "$TUI_ROOT/lib/dapk/dapk.sh"
        dapk.cmd.dispatch "$@"; exit $?
        ;;
    scan)
        shift
        # shellcheck source=../lib/apps/tui_scan.sh
        source "$TUI_ROOT/lib/apps/tui_scan.sh"
        tui.scan.cli "$@"; exit $?
        ;;
    clear-cache|--clear-cache) _clear_cache ;;
    reinstall|--reinstall)  shift; yes=0; [[ "${1:-}" == --yes || "${1:-}" == -y ]] && { yes=1; shift; }; _reinstall "$@" ;;
    uninstall|--uninstall)  shift; yes=0; for a in "$@"; do [[ "$a" == --yes || "$a" == -y ]] && yes=1; done; _uninstall "$@" ;;
    update)
        shift
        # shellcheck source=../lib/tui.sh
        source "$TUI_ROOT/lib/tui.sh"
        tui.update.cli "$@"
        ;;
    *)                      echo "dabt: unknown option '$1'" >&2; _help >&2; exit 1 ;;
esac; exit $?    # one line: `dabt update` can overwrite this very file, so bash must not read on past the case
