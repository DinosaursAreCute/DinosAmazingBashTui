<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- Schema for the tui_markup.sh declarative TUI format (kept in step with the attributes the loader reads).
       Not schema-expressible: pane ids must be unique per page; a widget's pane must be a leaf; class names come
       from the loaded theme (.class, .class:focus/:hover/:border/:title/:checked/:unchecked). Not enforced at
       parse time (the loader is a lightweight bash regex parser) - this file
       exists purely so editors can offer autocompletion/validation. -->

  <xs:simpleType name="alignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="right"/>
      <xs:enumeration value="fill"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="valignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top"/>
      <xs:enumeration value="middle"/>
      <xs:enumeration value="bottom"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="splitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="h"/>
      <xs:enumeration value="v"/>
      <xs:enumeration value="grid"/>
      <xs:enumeration value="fixed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tabsStyleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="framed"/>
      <xs:enumeration value="compact"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pack"/>
      <xs:enumeration value="stretch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="boolType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="borderType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="single"/>
      <xs:enumeration value="double"/>
      <xs:enumeration value="heavy"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

<xs:simpleType name="scroll">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="v"/>
      <xs:enumeration value="h"/>
      <xs:enumeration value="both"/>
    </xs:restriction>
</xs:simpleType>

  <xs:simpleType name="scopeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="global"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="footer">
    <xs:annotation><xs:documentation>One-row key-hint bar drawn on the last terminal row wherever it is declared. items = "KEY|Label[|WHEN_FN];..."; KEY may be "@tui.action.name" to show the key currently bound to that action.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attribute name="items" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="bind">
    <xs:complexType>
      <xs:attribute name="key" type="xs:string" use="required"/>
      <xs:attribute name="action" type="xs:string" use="required"/>
      <xs:attribute name="scope" type="scopeType"/>
      <xs:attribute name="pane" type="xs:string"/>
      <xs:attribute name="group" type="xs:string"/>
      <xs:attribute name="pass" type="boolType"/>
      <xs:attribute name="always" type="boolType"/>
      <xs:attribute name="desc" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tui">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="script"/>
        <xs:element ref="theme"/>
        <xs:element ref="include"/>
        <xs:element ref="pane"/>
        <xs:element ref="label"/>
        <xs:element ref="input"/>
        <xs:element ref="button"/>
        <xs:element ref="bind"/>
        <xs:element ref="footer"/>
        <xs:element ref="checkbox"/>
        <xs:element ref="password"/>
        <xs:element ref="textarea"/>
        <xs:element ref="list"/>
        <xs:element ref="table"/>
        <xs:element ref="select"/>
        <xs:element ref="progress"/>
        <xs:element ref="tabs"/>
      </xs:choice>
      <xs:attribute name="on_visit" type="xs:string"/>
      <!-- comma/space separated default keybind groups to switch off for this page, e.g. "-quit,-scroll" -->
      <xs:attribute name="defaults" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="script">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="theme">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="include">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="pane">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="pane"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="split" type="splitType"/>
      <xs:attribute name="weight" type="xs:positiveInteger"/>
      <xs:attribute name="title" type="xs:string"/>
      <xs:attribute name="border" type="borderType"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="scroll" type="scroll"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="min_height" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_height" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="strict_fit" type="boolType"/>
      <!-- split="fixed" only: every child is exactly size_w x size_h cells, flowed left to right and wrapped (tui.fixed) -->
      <xs:attribute name="size_w" type="xs:positiveInteger"/>
      <xs:attribute name="size_h" type="xs:positiveInteger"/>
      <!-- direct child of a split="fixed" parent only: width in cell units, and force a new row before this child -->
      <xs:attribute name="span" type="xs:positiveInteger"/>
      <xs:attribute name="newline" type="boolType"/>
      <!-- split="grid" only -->
      <xs:attribute name="rows" type="xs:positiveInteger"/>
      <xs:attribute name="cols" type="xs:positiveInteger"/>
      <xs:attribute name="fit" type="fitType"/>
      <xs:attribute name="row_weights" type="xs:string"/>
      <xs:attribute name="col_weights" type="xs:string"/>
      <!-- direct child of a split="grid" parent only -->
      <xs:attribute name="grid_row" type="xs:nonNegativeInteger"/>
      <xs:attribute name="grid_col" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="label">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="text" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="input">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="label" type="xs:string"/>
      <xs:attribute name="placeholder" type="xs:string"/>
      <xs:attribute name="submit" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="label_align" type="alignType"/>
      <xs:attribute name="retain_input_on_submit" type="boolType"/>
      <xs:attribute name="sticky" type="boolType"/>
      <xs:attribute name="label_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="button">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="text" type="xs:string"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="page" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="checkbox">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="label" type="xs:string"/>
      <xs:attribute name="checked" type="boolType"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="password">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="label" type="xs:string"/>
      <xs:attribute name="placeholder" type="xs:string"/>
      <xs:attribute name="submit" type="xs:string"/>
      <xs:attribute name="label_align" type="alignType"/>
      <xs:attribute name="label_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="on_change" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="textarea">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="placeholder" type="xs:string"/>
      <xs:attribute name="rows" type="xs:nonNegativeInteger"/>
      <xs:attribute name="value" type="xs:string"/>
      <xs:attribute name="submit" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="on_change" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="list">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="rows" type="xs:nonNegativeInteger"/>
      <xs:attribute name="items" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="on_change" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="table">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="rows" type="xs:nonNegativeInteger"/>
      <xs:attribute name="columns" type="xs:string"/>
      <xs:attribute name="data" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="on_change" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="select">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="label" type="xs:string"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="items" type="xs:string"/>
      <xs:attribute name="value" type="xs:string"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="on_change" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="progress">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="pane" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:integer" use="required"/>
      <xs:attribute name="label" type="xs:string"/>
      <xs:attribute name="value" type="xs:nonNegativeInteger"/>
      <xs:attribute name="align" type="alignType"/>
      <xs:attribute name="valign" type="valignType"/>
      <xs:attribute name="min_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="max_width" type="xs:nonNegativeInteger"/>
      <xs:attribute name="hpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vpad" type="xs:nonNegativeInteger"/>
      <xs:attribute name="class" type="xs:string"/>
      <xs:attribute name="on_change" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tabs">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tab" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="header_pane" type="xs:string" use="required"/>
      <xs:attribute name="content_pane" type="xs:string" use="required"/>
      <xs:attribute name="style" type="tabsStyleType"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tab">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="text" type="xs:string"/>
      <xs:attribute name="action" type="xs:string"/>
      <xs:attribute name="default" type="boolType"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
