<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="lab_visit">
  <script src="debug_tabs.sh"/>
  <script src="debug_lab_callbacks.sh"/>
  <theme src="theme.css"/>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <include src="_header.xml"/>
  <pane id="root1" weight="90" split="h">
    <pane id="nav" weight="18" title="Menu" border="single" class="sidebar"/>
    <pane id="main" split="v" weight="82" border="none">
      <pane id="tabs_header" weight="5" border="none"/>
      <pane id="body" split="h" weight="95" border="none">
        <pane id="lab_buttons" weight="46" title="Trigger" border="single" class="panel" hpad="1"/>
        <pane id="right" split="v" weight="54" border="none">
          <pane id="lab_state" weight="52" title="Live state (updates by itself)" border="single" class="panel" hpad="1" scroll="both"/>
          <pane id="lab_log"   weight="48" title="What happened" border="single" class="panel" hpad="1" scroll="v"/>
        </pane>
      </pane>
    </pane>
  </pane>
  </pane>

  <tabs id="lab_tabs" header_pane="tabs_header" content_pane="body" style="compact">
    <tab id="tab_dbg_events" text="Events &amp; hover"   action="dbg_goto_events"/>
    <tab id="tab_dbg_input"  text="Keyboard &amp; mouse" action="dbg_goto_input"/>
    <tab id="tab_dbg_lab"    text="Feature lab"          action="dbg_tab_here" default="true"/>
  </tabs>

  <label  id="lb_h1" pane="lab_buttons" row="0" text="Command bar &amp; overlays" class="brand"/>
  <button id="lb_pal"    pane="lab_buttons" row="1" text="[ Open the command palette ]"        action="lab_palette"     class="info_button"    align="fill"/>
  <button id="lb_pal2"   pane="lab_buttons" row="2" text="[ Palette pre-filled with 'theme ' ]" action="lab_palette_q"   class="info_button"    align="fill"/>
  <button id="lb_cmd"    pane="lab_buttons" row="3" text="[ Register 'Lab: hello' (tui.cmd.add) ]" action="lab_cmd_add"   class="success_button" align="fill"/>
  <button id="lb_cmdrm"  pane="lab_buttons" row="4" text="[ Remove it again ]"                 action="lab_cmd_remove"  class="warning_button" align="fill"/>
  <button id="lb_modal"  pane="lab_buttons" row="5" text="[ Open a custom modal (tui.modal) ]" action="lab_modal_open"  class="success_button" align="fill"/>
  <button id="lb_ovl"    pane="lab_buttons" row="6" text="[ Toggle an overlay box (tui.overlay) ]" action="lab_overlay_toggle" class="success_button" align="fill"/>

  <label  id="lb_h2" pane="lab_buttons" row="8" text="Modes" class="brand"/>
  <button id="lb_kill"   pane="lab_buttons" row="9"  text="[ Keybinds off (kill-switch) ]"      action="lab_kill"        class="danger_button"  align="fill"/>
  <button id="lb_term"   pane="lab_buttons" row="10" text="[ Terminal mode (pass-through) ]"    action="lab_term"        class="danger_button"  align="fill"/>

  <label  id="lb_h3" pane="lab_buttons" row="12" text="Focus &amp; pages" class="brand"/>
  <button id="lb_pn"     pane="lab_buttons" row="13" text="[ Focus next pane ]"     action="lab_pane_next" class="info_button" align="fill"/>
  <button id="lb_pp"     pane="lab_buttons" row="14" text="[ Focus previous pane ]" action="lab_pane_prev" class="info_button" align="fill"/>
  <button id="lb_pnav"   pane="lab_buttons" row="15" text="[ Focus the menu pane ]" action="lab_pane_nav"  class="info_button" align="fill"/>
  <button id="lb_dset"   pane="lab_buttons" row="16" text="[ Open DABT's default Settings page ]" action="lab_default_settings" class="success_button" align="fill"/>
  <button id="lb_dkb"    pane="lab_buttons" row="17" text="[ Open DABT's default Keybinds page ]" action="lab_default_keybinds" class="success_button" align="fill"/>

  <label  id="lb_h4" pane="lab_buttons" row="19" text="Clipboard, paste and input focus" class="brand"/>
  <input  id="inp_clip"  pane="lab_buttons" row="20" label="copy:"  label_width="8" placeholder="text for the clipboard (Enter copies)" submit="lab_copy"/>
  <input  id="inp_paste" pane="lab_buttons" row="21" label="paste:" label_width="8" placeholder="paste here (ctrl+shift+v): one event"/>
  <input  id="inp_keep"  pane="lab_buttons" row="22" label="keeps:" label_width="8" placeholder="Enter submits, cursor stays" submit="lab_submit_keep"/>
  <input  id="inp_form"  pane="lab_buttons" row="23" label="leaves:" label_width="8" placeholder="Enter submits, then leaves" submit="lab_submit_form" retain_input_on_submit="false"/>

  <include src="_nav.xml"/>
</tui>
