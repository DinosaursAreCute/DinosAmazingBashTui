<tui shell="_shell.xml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="tui.xsd" on_visit="on_docu_visit">
  <script src="docu_callbacks.sh"/>

  <pane id="main" split="h">
      <!-- the document list: drag the divider to resize, the chevron (alt+c) collapses it, the list scrolls -->
      <pane id="doc_list" weight="26" title="Documents" border="single" class="panel" collapsible="true" collapse_to="title" default="expanded" resizable="x" handle="divider" keep_size="true" keep_collapsed="true">
        <list id="lst_docs" rows="0" action="on_docu_open" on_change="on_docu_moved"/>
      </pane>
      <pane id="content" weight="74" border="heavy" class="panel" scroll="both"/>
  </pane>
</tui>
