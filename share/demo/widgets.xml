<tui shell="_shell.xml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="wx_visit">
  <script src="widgets_callbacks.sh"/>

  <pane id="main" split="h" border="none">
    <pane id="wx_left" split="v" weight="46" border="none">
      <pane id="wx_notes" resizable="both" collapsible="true" handle="corner"  weight="88" title="Notes (textarea) - select, cut, paste, ctrl+arrows, click" border="single" class="panel" hpad="1">
        <!-- text editing: the textarea fills its pane; on_change keeps the status line current -->
        <textarea id="wx_text" placeholder="type here..." on_change="wx_text_changed"/>
      </pane>
      <pane id="wx_status" weight="12" border="single" class="panel" hpad="1">
        <label id="wx_stat1" text="" class="brand"/>
      </pane>
    </pane>
    <pane id="wx_right" split="v" weight="54" border="none">
      <pane id="wx_form" weight="42" title="Form (input, password, select, progress)" border="single" class="panel" hpad="1">
        <input    id="wx_user" label="User:" label_width="6" placeholder="name" submit="wx_login" keep_value="true"/>
        <password id="wx_pass" label="Pass:" label_width="6" placeholder="password" submit="wx_login"/>
        <select   id="wx_mode" row="3" label="Mode:" items="fast|balanced|careful" value="balanced" action="wx_mode_picked"/>
        <button   id="wx_go" row="5" text="[ Sign in ]" action="wx_login" class="success_button" align="fill"/>
        <button   id="wx_job" row="6" text="[ Run a job ]" action="wx_run_job" class="info_button" align="fill"/>
        <progress id="wx_prog" row="8" label="Job:" value="0"/>
      </pane>
      <pane id="wx_data" weight="58" title="Data (list, table)" border="single" class="panel" hpad="1">
        <list  id="wx_list" rows="6" action="wx_list_open" on_change="wx_list_moved" items="Home|Components|Settings|Monitor|Terminal|Scrolling|Docs|Layout|Styles|Widgets"/>
        <table id="wx_table" row="7" action="wx_table_open" columns="File|Size|Kind" data="README.md|8k|text;CHANGELOG.md|21k|text;lib/tui.sh|121k|script;lib/widgets/tui_text.sh|24k|script;docs/README.md|9k|text;screenshots/|4.1M|images;config/|60k|dir"/>
      </pane>
    </pane>
  </pane>
</tui>
