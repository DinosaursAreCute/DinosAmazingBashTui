<tui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../tui.xsd" on_visit="generated_visit">
  <include src="_templates.xml"/>
  <script src="demo_callbacks.sh"/>
  <script src="generated_callbacks.sh"/>
  <theme src="theme.css"/>

  <!-- Everything in the right-hand pane is generated: ONE template, ONE loop over cards, and inside the template a
       loop over items plus an <if>. The control panel under the menu sets the numbers; "Generate" writes them as a
       tiny addon (gen_values.xml) that changes the `count`, `title`, `items` and `compact` written below, and the
       page is rebuilt. Nothing in the right pane is written out by hand. -->
  <template name="card" title="Card" n="0" items="2" compact="false">
    <pane id="c" title="{{@title}} #{{@n}}" class="panel" hpad="1">
      <label id="head" text="Card {{@n}}: {{@title}}" class="brand"/>
      <for count="{{@items}}" index="i">
        <label id="item{{@i}}" text="  - item {{@i}} of card {{@n}}"/>
      </for>
      <if test="{{@compact}}==false">
        <label id="foot_full" text="(full view)" class="muted_label"/>
        <else>
          <label id="foot_compact" text="(compact)" class="muted_label"/>
        </else>
      </if>
    </pane>
  </template>

  <pane id="root" split="v" title="Dinos Amazing Bash TUI" border="single" class="sidebar">
    <use template="dabt_header"/>
    <pane id="root1" weight="90" split="h">
      <pane id="left" split="v" weight="24" border="none">
        <pane id="nav" weight="62" title="Menu" border="single" class="sidebar"/>
        <pane id="ctl" weight="38" title="Generate" class="panel" hpad="1">
          <input id="inp_cards" label="Cards:" label_width="7" placeholder="any number"/>
          <input id="inp_items" label="Items:" label_width="7" placeholder="any number"/>
          <input id="inp_title" label="Title:" label_width="7" placeholder="Card"/>
          <checkbox id="chk_compact" label="compact"/>
          <button id="btn_gen" text="[ Generate ]" action="on_gen_apply" class="success_button" align="fill"/>
        </pane>
      </pane>
      <pane id="out" split="h" weight="76" title="Generated from a template and loops" class="panel">
        <for id="cards" count="3" index="n">
          <use template="card" id="card{{@n}}" n="{{@n}}" title="Card" items="2" compact="false"/>
        </for>
      </pane>
    </pane>
  </pane>

  <use template="dabt_nav"/>
</tui>
