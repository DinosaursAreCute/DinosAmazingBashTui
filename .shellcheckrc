 # Look for 'source'd files relative to the checked script itself (not the
 # invocation cwd), so `# shellcheck source=` directives resolve the same way
 # whether shellcheck runs from the repo root, from lib/, or per-file from an
 # editor - needed now that lib/ is split into topic subdirectories.
 source-path=SCRIPTDIR
 
 # Allow opening any 'source'd file, even if not specified as input
 external-sources=true

 # Turn on warnings for unquoted variables with safe values
 enable=quote-safe-variables

 # Turn on warnings for unassigned uppercase variables
 enable=check-unassigned-uppercase

#Used In comments we do not care about this. 
 disable=SC2006
